---
import Layout from '../../components/Layout.astro';
import ProvenanceNote from '../../components/ProvenanceNote.astro';
import { formulations, moleculesOf, productsForFormulation } from '../../lib/mock';
import { buildLadder } from '../../lib/ladder';
import { inr, channelLabel } from '../../lib/format';
import { withBase } from '../../lib/base';

export function getStaticPaths() {
  return formulations.map((f) => ({ params: { slug: f.slug } }));
}
const { slug } = Astro.params;
const f = formulations.find((x) => x.slug === slug)!;
const mols = moleculesOf(f);
const l = buildLadder(f.id, 30);
const flagship = productsForFormulation(f.id).find((p) => p.channel === 'branded') ?? productsForFormulation(f.id)[0]!;
---
<Layout title={`${f.label} — price ladder · Salt`} description={`Every brand of ${f.label} ranked by price, with the NPPA legal maximum.`}>
  <section class="wrap page">
    <nav class="crumbs mono muted"><a href={withBase('/')} class="ulink">Search</a> › <a href={withBase(`/molecule/${mols[0]?.slug}`)} class="ulink">{mols[0]?.name}</a> › <span>{f.label}</span></nav>
    <div class="between fh" data-reveal>
      <div>
        <h1 class="serif fh-title">{f.label}</h1>
        <p class="muted mono">{f.form} · {f.release} · {mols.map((m) => m.name).join(' + ')}</p>
      </div>
      {l.legalMaxPerUnit && <span class="pill pill-gold">⚖ legal max {inr(l.legalMaxPerUnit)}/{f.packUnit}</span>}
    </div>

    <div class="between ladder-head" data-reveal><h2 class="serif">Ranked by price · 30 {f.packUnit}s</h2>
      <a href={withBase(`/medicine/${flagship.slug}`)} class="btn btn-outline btn-sm">Adjust quantity & pincode <span class="arrow">→</span></a></div>
    <ol class="ladder">
      {l.rows.map((r, i) => (
        <li class:list={['lrow', { best: i === 0 }]} data-reveal data-reveal-delay={i * 40}>
          <span class="lrank mono">{i + 1}</span>
          <div class="lmain">
            <div class="lbrand"><a href={withBase(`/medicine/${r.product.slug}`)} class="ulink">{r.product.brand}</a> <span class="pill pill-line lch">{channelLabel[r.product.channel]}</span>{r.overCeiling && <span class="pill pill-clay">over ceiling</span>}</div>
            <div class="lsub muted mono">{r.product.manufacturer} · {r.product.packSize}-{f.packUnit} pack · {inr(r.unitPrice)}/{f.packUnit}</div>
          </div>
          <div class="lcost"><span class="lcost-num mono">{inr(r.effectiveCost)}</span><span class="lcost-lbl muted mono">{r.packsNeeded} pack{r.packsNeeded > 1 ? 's' : ''}</span></div>
          <div class="lcta">{i === 0 ? <span class="pill pill-leaf">✓ best</span> : (r.savingVsCostliest > 0 ? <span class="pill pill-leaf">save {inr(r.savingVsCostliest)}</span> : <span class="muted mono">—</span>)}</div>
        </li>
      ))}
    </ol>
    <ProvenanceNote sourceIds={l.sourceIds} asOf="2026-07-28" />
    <p class="advice mono">ⓘ Price information only, not medical advice. Talk to your doctor or pharmacist before changing any medicine.</p>
  </section>
</Layout>
<style>
  .page { padding-block: var(--sp-5) var(--sp-4); }
  .crumbs { font-size: var(--step--1); display: flex; gap: 0.5em; margin-bottom: 1.4em; flex-wrap: wrap; }
  .fh { margin-bottom: var(--sp-5); align-items: flex-end; }
  .fh-title { font-size: var(--step-3); }
  .ladder-head { margin-bottom: 1em; }
  .advice { margin-top: var(--sp-5); font-size: var(--step--1); color: var(--ink-3); padding: 0.9em 1.1em; border: 1px dashed var(--border); border-radius: var(--r-2); }
</style>
