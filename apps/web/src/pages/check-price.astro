---
import Layout from '../components/Layout.astro';
import { formulations, ceilingByFormulation } from '../lib/mock';
import { inr } from '../lib/format';
const withCeiling = formulations.filter((f) => ceilingByFormulation.has(f.id));
const steps = [
  ['Note the details', 'Keep the bill, batch number, and the pharmacy name.'],
  ['File with NPPA', 'Report on the NPPA’s Pharma Jan Samadhan portal or the 1800-111-255 helpline.'],
  ['Track it', 'Overcharging above the DPCO ceiling is an offence; NPPA can order a refund with interest.'],
];
---
<Layout title="Overcharge checker · Salt" description="Enter what you paid and see instantly whether it’s above the legal maximum price — and how to complain to the NPPA.">
  <section class="hero-sm paper-tex">
    <div class="wrap wrap-narrow">
      <p class="eyebrow" data-reveal>Overcharge checker</p>
      <h1 data-reveal data-reveal-delay="60">Did you pay more than the law allows?</h1>
      <p class="lede" data-reveal data-reveal-delay="120">Many medicines have a statutory ceiling price. Enter what you were charged and we’ll compare it — and show the cheaper legal options.</p>
    </div>
  </section>

  <section class="wrap wrap-narrow">
    <div class="card card-pad checker" data-checker data-reveal>
      <div class="grid checker-grid">
        <label class="ctrl">
          <span class="ctrl-label mono">Medicine</span>
          <select class="field" data-med>
            {withCeiling.map((f) => <option value={f.id}>{f.label}</option>)}
          </select>
        </label>
        <label class="ctrl">
          <span class="ctrl-label mono">Quantity</span>
          <input class="field" type="number" min="1" value="30" data-qty />
        </label>
        <label class="ctrl">
          <span class="ctrl-label mono">You paid (₹ per unit)</span>
          <input class="field" inputmode="decimal" placeholder="e.g. 3.20" data-paid />
        </label>
      </div>
      <button class="btn btn-accent btn-lg btn-block" data-go>Check my price <span class="arrow">→</span></button>
      <div class="checker-result" data-result hidden></div>
    </div>

    <div class="complaint" data-reveal data-reveal-delay="80">
      <h2 class="serif" id="complain">If you were overcharged</h2>
      <ol class="complaint-steps">
        {steps.map(([t, d], i) => (
          <li class="card card-pad">
            <span class="cs-n mono">{String(i + 1).padStart(2, '0')}</span>
            <div><strong>{t}</strong><p class="muted">{d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .hero-sm { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .checker { margin-top: -1.5rem; position: relative; z-index: 2; }
  .checker-grid { grid-template-columns: 1.6fr 0.8fr 1fr; gap: var(--sp-3); margin-bottom: var(--sp-3); }
  .ctrl-label { display: block; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.5em; }
  .checker-result { margin-top: var(--sp-4); }
  .complaint { margin-top: var(--sp-6); }
  .complaint-steps { list-style: none; padding: 0; display: grid; gap: var(--sp-3); margin-top: var(--sp-3); }
  .complaint-steps li { display: flex; gap: var(--sp-3); align-items: flex-start; }
  .cs-n { color: var(--saffron); font-size: 1.1rem; font-weight: 600; }
  @media (max-width: 680px) { .checker-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { buildLadder } from '../lib/ladder';
  import { inr, inr0 } from '../lib/format';
  function wire(root: HTMLElement) {
    if (root.dataset.wired) return; root.dataset.wired = '1';
    const med = root.querySelector<HTMLSelectElement>('[data-med]')!;
    const qty = root.querySelector<HTMLInputElement>('[data-qty]')!;
    const paid = root.querySelector<HTMLInputElement>('[data-paid]')!;
    const go = root.querySelector<HTMLButtonElement>('[data-go]')!;
    const out = root.querySelector<HTMLElement>('[data-result]')!;
    const run = () => {
      const fid = Number(med.value);
      const q = Math.max(1, Number(qty.value) || 1);
      const paidV = parseFloat(paid.value);
      const l = buildLadder(fid, q, Number.isFinite(paidV) ? paidV : undefined);
      const cheapest = l.cheapest!;
      if (!l.overcharge) {
        out.hidden = false; out.className = 'checker-result card card-pad';
        out.innerHTML = `<p class="muted">Enter what you paid per unit to compare against the legal maximum of <span class="mono">${inr(l.legalMaxPerUnit!)}</span>.</p>`;
        return;
      }
      const o = l.overcharge;
      out.hidden = false;
      out.className = 'checker-result card card-pad ' + (o.isOvercharge ? 'oc-bad' : 'oc-ok');
      out.innerHTML = `
        <div class="oc-h ${o.isOvercharge ? '' : 'ok'}">${o.isOvercharge ? 'Overcharged.' : 'Within the legal maximum.'}</div>
        <div class="oc-grid">
          <div><div class="mono muted">you paid</div><div class="oc-num mono">${inr(o.quotedUnitPrice)}</div></div>
          <div><div class="mono muted">legal max</div><div class="oc-num mono" style="color:var(--gold)">${inr(o.legalMaxPerUnit)}</div></div>
          <div><div class="mono muted">${o.isOvercharge ? 'over by' : 'headroom'}</div><div class="oc-num mono" style="color:${o.isOvercharge ? 'var(--clay)' : 'var(--leaf)'}">${inr(Math.abs(o.overByPerUnit))}</div></div>
        </div>
        <p class="oc-line">${o.isOvercharge
          ? `That’s about <strong class="mono">${inr(o.overByTotal)}</strong> too much for ${q} units. And Jan Aushadhi sells this at <strong class="mono">${inr(cheapest.unitPrice)}/unit</strong> — <strong>${inr0((o.quotedUnitPrice - cheapest.unitPrice) * q)}</strong> less for your ${q}.`
          : `Still, Jan Aushadhi sells this at <strong class="mono">${inr(cheapest.unitPrice)}/unit</strong> — cheaper than what you paid.`}</p>
        ${o.isOvercharge ? `<a class="btn btn-accent btn-sm" href="#complain">How to complain <span class="arrow">→</span></a>` : ''}`;
    };
    go.addEventListener('click', run);
    paid.addEventListener('keydown', (e) => { if (e.key === 'Enter') run(); });
  }
  document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('[data-checker]').forEach(wire));
</script>

<style is:global>
  .oc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); margin: 1em 0; }
  .oc-num { font-size: var(--step-2); font-weight: 700; }
  .oc-line { font-size: var(--step--1); margin-bottom: 0.9em; }
</style>
