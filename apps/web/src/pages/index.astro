---
import Layout from '../components/Layout.astro';
import SearchBox from '../components/SearchBox.astro';
import NearbySources from '../components/NearbySources.astro';
import { conversionForProduct } from '../lib/convert';
import { moleculesOf } from '../lib/mock';
import { formulationById } from '../lib/mock';
import { inr, inr0, channelLabel } from '../lib/format';

const demo = conversionForProduct('dolo-650', 30);
const f = formulationById.get(demo.branded.formulationId)!;
const genericName = f.label; // the molecule + strength = the generic's real name
const popular = [
  ['Dolo 650', '/medicine/dolo-650'],
  ['Telma 40', '/medicine/telma-40'],
  ['Glycomet 500', '/medicine/glycomet-500'],
  ['Pan 40', '/medicine/pan-40'],
  ['Storvas 10', '/medicine/storvas-10'],
];
---
<Layout>
  <!-- HERO: search + scan, the two ways in -->
  <section class="hero paper-tex">
    <div class="wrap hero-inner">
      <p class="eyebrow" data-reveal>Brand name in · generic + nearby price out</p>
      <h1 class="display hero-title" data-reveal data-reveal-delay="60">
        Find the generic.<br /><span class="hl">Pay up to 90% less.</span>
      </h1>
      <p class="lede hero-lede" data-reveal data-reveal-delay="120">
        Type the brand on your strip — or scan the whole prescription. We name the exact generic,
        show what it costs, and point you to the cheapest place nearby to get it.
      </p>

      <div class="hero-actions" data-reveal data-reveal-delay="180">
        <div class="hero-search">
          <label class="hero-search-label mono">1 · Search a brand</label>
          <SearchBox big autofocus placeholder="Type a brand — e.g. Dolo 650, Telma 40…" />
          <div class="popular cluster">
            <span class="muted mono pop-label">Try</span>
            {popular.map(([label, href]) => <a href={href} class="chip">{label}</a>)}
          </div>
        </div>
        <div class="hero-or mono">or</div>
        <a href="/scan" class="scan-cta" data-reveal data-reveal-delay="230">
          <span class="scan-cta-label mono">2 · Scan a prescription</span>
          <span class="scan-cta-icon" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg>
          </span>
          <span class="scan-cta-text">Find the generic for <strong>every line</strong> at once <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- THE CONVERSION: brand → generic + nearby sources (the money shot) -->
  <section class="section convsec">
    <div class="wrap">
      <p class="eyebrow" data-reveal>What you get back</p>
      <h2 class="conv-h" data-reveal data-reveal-delay="60">Search <span class="brandword">{demo.branded.brand}</span>, get this.</h2>

      <div class="conv-grid">
        <!-- the swap -->
        <div class="conv-swap card" data-reveal data-reveal-delay="100">
          <div class="swap-side branded">
            <div class="mono muted swap-tag">You searched · branded</div>
            <div class="swap-name serif">{demo.branded.brand}</div>
            <div class="swap-sub muted">{genericName} · {demo.branded.manufacturer}</div>
            <div class="swap-price mono">{inr(demo.brandedRow.effectiveCost)}<span class="swap-unit">for 30</span></div>
          </div>
          <div class="swap-arrow" aria-hidden="true">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </div>
          <div class="swap-side generic">
            <div class="mono swap-tag gen-tag">The generic · {channelLabel[demo.generic.product.channel]}</div>
            <div class="swap-name serif">{genericName}</div>
            <div class="swap-sub muted">{demo.generic.product.brand} · {demo.generic.product.manufacturer}</div>
            <div class="swap-price mono gen-price">{inr(demo.generic.effectiveCost)}<span class="swap-unit">for 30</span></div>
            <div class="swap-save pill pill-leaf">save {inr0(demo.savingAbs)} · {demo.savingPct}% less</div>
          </div>
        </div>

        <!-- nearby sources -->
        <div class="conv-nearby" data-reveal data-reveal-delay="160">
          <NearbySources pincode="560034" limit={3} heading="Get it near you" />
        </div>
      </div>

      <div class="conv-footcta" data-reveal>
        <a href={`/medicine/${demo.branded.slug}`} class="btn btn-ink btn-lg">See the full comparison for {demo.branded.brand} <span class="arrow">→</span></a>
        <span class="muted mono conv-note">same molecule · same strength · same salt & release — checked, not guessed</span>
      </div>
    </div>
  </section>

  <!-- SCAN, front and centre -->
  <section class="section scansec">
    <div class="wrap scan-band" data-reveal>
      <div class="scan-copy">
        <p class="eyebrow">The whole prescription at once</p>
        <h2>Scan it. We find a cheaper generic for every line.</h2>
        <p class="lede">Photograph the prescription — we read each medicine, name its generic, price the basket, and show where to buy nearby. You confirm every line; nothing is stored.</p>
        <a href="/scan" class="btn btn-accent btn-lg">Scan a prescription <span class="arrow">→</span></a>
      </div>
      <ol class="scan-steps">
        <li><span class="ss-n mono">01</span><div><strong>Read every line</strong><p class="muted">Brand, strength, form — resolved to the exact formulation.</p></div></li>
        <li><span class="ss-n mono">02</span><div><strong>Name the generic</strong><p class="muted">The cheapest equivalent for each, with the saving.</p></div></li>
        <li><span class="ss-n mono">03</span><div><strong>Find it nearby</strong><p class="muted">Jan Aushadhi kendras near your pincode — click through.</p></div></li>
      </ol>
    </div>
  </section>

  <!-- SECONDARY: the legal maximum + overcharge (a side benefit, demoted) -->
  <section class="section">
    <div class="wrap side-strip card card-pad" data-reveal>
      <div>
        <span class="pill pill-gold">Also</span>
        <h3 class="side-h serif">Check the legal maximum on any price.</h3>
        <p class="muted">Many medicines have a statutory ceiling. If you were charged more, that’s not a markup — it’s illegal. A quick side-check, one tap away.</p>
      </div>
      <a href="/check-price" class="btn btn-outline">Overcharge check <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- STATS -->
  <section class="statsec">
    <div class="wrap stats grid">
      {[
        { v: 6000, s: '', label: 'formulations in scope' },
        { v: 19238, s: '', label: 'pincodes for kendra search' },
        { v: 90, s: '%', label: 'typical generic saving' },
        { v: 0, s: '', p: '₹', label: 'cost to you — always' },
      ].map((st, i) => (
        <div class="stat" data-reveal data-reveal-delay={i * 80}>
          <div class="stat-v serif" data-count={st.v} data-count-prefix={st.p ?? ''} data-count-suffix={st.s}>{st.p ?? ''}0{st.s}</div>
          <div class="stat-l muted mono">{st.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="cta card card-pad paper-tex" data-reveal>
        <h2 class="cta-title">Start with a brand you have at home.</h2>
        <div class="cta-search"><SearchBox big /></div>
        <p class="cta-or muted">…or <a href="/scan" class="ulink">scan a prescription →</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: clamp(2.2rem, 5vw, 4rem); padding-bottom: clamp(1.5rem, 4vw, 3rem); }
  .hero-inner { max-width: 1000px; }
  .hero-title { margin-top: 0.3em; }
  .hl { color: var(--teal); font-style: italic; }
  .hero-lede { margin-top: 0.9em; max-width: 56ch; }
  .hero-actions { margin-top: 2em; display: grid; grid-template-columns: 1fr auto 0.85fr; gap: var(--sp-4); align-items: stretch; }
  .hero-search-label, .scan-cta-label { display: block; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--saffron-2); margin-bottom: 0.6em; font-weight: 600; }
  .popular { margin-top: 1em; gap: 0.5em; }
  .pop-label { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .chip { padding: 0.42em 0.85em; border-radius: var(--r-full); border: 1px solid var(--border); background: var(--card); font-size: var(--step--1); font-weight: 550; transition: transform 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease); }
  .chip:hover { transform: translateY(-2px); border-color: var(--teal); color: var(--teal); }
  .hero-or { align-self: center; color: var(--ink-3); font-size: var(--step--1); }
  .scan-cta { display: flex; flex-direction: column; gap: 0.7em; padding: 1.3em; border-radius: var(--r-3); background: var(--teal); color: #fff;
    box-shadow: var(--shadow-2); position: relative; overflow: hidden; isolation: isolate; transition: transform 0.22s var(--ease), box-shadow 0.25s var(--ease); }
  .scan-cta:hover { transform: translateY(-3px); box-shadow: var(--shadow-3); }
  .scan-cta::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(400px 200px at 120% -20%, rgba(255,255,255,0.18), transparent 60%); }
  .scan-cta .scan-cta-label { color: color-mix(in oklab, #fff 78%, var(--teal)); margin-bottom: 0; }
  .scan-cta-icon { width: 2.6em; height: 2.6em; display: grid; place-items: center; border-radius: var(--r-2); background: rgba(255,255,255,0.14); }
  .scan-cta-text { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.15; }
  .scan-cta-text strong { font-style: italic; }

  .convsec { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .conv-h { font-size: var(--step-3); margin-top: 0.2em; }
  .brandword { color: var(--saffron); font-style: italic; }
  .conv-grid { display: grid; grid-template-columns: 1.35fr 0.85fr; gap: var(--sp-4); margin-top: 1.6em; align-items: stretch; }
  .conv-swap { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--sp-3); padding: clamp(1.2rem, 3vw, 2rem); }
  .swap-side { min-width: 0; }
  .swap-tag { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.6em; }
  .gen-tag { color: var(--leaf); }
  .swap-name { font-size: var(--step-2); line-height: 1.05; }
  .swap-sub { font-size: var(--step--1); margin-top: 0.3em; }
  .swap-price { font-size: var(--step-2); font-weight: 700; margin-top: 0.7em; display: flex; align-items: baseline; gap: 0.35em; }
  .gen-price { color: var(--leaf); }
  .swap-unit { font-size: 0.6em; color: var(--ink-3); font-family: var(--font-sans); font-weight: 500; }
  .swap-save { margin-top: 0.8em; }
  .swap-arrow { color: var(--teal); display: grid; place-items: center; }
  .swap-side.generic { padding: 1.1em; border-radius: var(--r-3); background: linear-gradient(160deg, var(--leaf-soft), var(--card)); border: 1px solid color-mix(in oklab, var(--leaf) 30%, transparent); }
  .conv-footcta { margin-top: var(--sp-4); display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
  .conv-note { font-size: var(--step--1); }

  .scansec { background: var(--paper-2); border-block: 1px solid var(--border); }
  .scan-band { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--sp-6); align-items: center; }
  .scan-copy .lede { margin-block: 0.8em 1.4em; }
  .scan-steps { list-style: none; padding: 0; display: grid; gap: var(--sp-3); }
  .scan-steps li { display: flex; gap: var(--sp-3); align-items: flex-start; padding: 1em 1.2em; background: var(--card); border: 1px solid var(--border); border-radius: var(--r-3); }
  .ss-n { color: var(--saffron); font-weight: 600; font-size: 1rem; }
  .scan-steps p { font-size: var(--step--1); margin-top: 0.2em; }

  .side-strip { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); }
  .side-h { font-size: var(--step-1); margin: 0.5em 0 0.3em; }

  .statsec { padding-block: clamp(2rem, 5vw, 3.5rem); border-top: 1px solid var(--border); }
  .stats { grid-template-columns: repeat(4, 1fr); text-align: center; }
  .stat-v { font-size: var(--step-4); color: var(--teal); }
  .stat-l { font-size: var(--step--1); margin-top: 0.3em; }

  .cta { text-align: center; padding-block: clamp(2.2rem, 5vw, 3.5rem); }
  .cta-title { max-width: 20ch; margin-inline: auto; }
  .cta-search { max-width: 560px; margin: 1.5em auto 0.8em; }
  .cta-or { font-size: var(--step--1); }

  @media (max-width: 900px) {
    .hero-actions { grid-template-columns: 1fr; }
    .hero-or { justify-self: center; }
    .conv-grid { grid-template-columns: 1fr; }
    .scan-band { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); gap: var(--sp-5); }
  }
  @media (max-width: 560px) {
    .conv-swap { grid-template-columns: 1fr; }
    .swap-arrow { transform: rotate(90deg); }
    .side-strip { flex-direction: column; align-items: flex-start; }
  }
</style>
