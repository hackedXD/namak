---
import SearchBox from './SearchBox.astro';
const path = Astro.url.pathname;
const nav = [
  { href: '/check-price', label: 'Overcharge check' },
  { href: '/scan', label: 'Scan' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/sources', label: 'Sources' },
];
---
<header class="site-header" data-header>
  <div class="wrap head-inner">
    <a href="/" class="brand" aria-label="Salt home">
      <span class="brand-mark" aria-hidden="true">S</span>
      <span class="brand-word">Salt</span>
    </a>

    <div class="head-search"><SearchBox compact /></div>

    <nav class="head-nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} class:list={['navlink', 'ulink', { active: path.startsWith(n.href) }]}>{n.label}</a>
      ))}
      <button class="iconbtn theme-toggle" aria-label="Toggle colour theme" data-theme-toggle>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .site-header.scrolled { border-bottom-color: var(--border); box-shadow: var(--shadow-1); }
  .head-inner { display: flex; align-items: center; gap: var(--sp-3); padding-block: 0.7rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.5em; font-family: var(--font-display); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.02em; }
  .brand-mark {
    display: grid; place-items: center; width: 1.7em; height: 1.7em; border-radius: 8px;
    background: var(--teal); color: #fff; font-size: 0.85em; box-shadow: var(--shadow-1);
  }
  .head-search { flex: 1; max-width: 460px; }
  .head-nav { display: flex; align-items: center; gap: var(--sp-3); margin-left: auto; }
  .navlink { font-size: var(--step--1); font-weight: 550; color: var(--ink-2); }
  .navlink.active { color: var(--teal); }
  .theme-toggle { width: 2.2em; height: 2.2em; }
  @media (max-width: 860px) {
    .head-search { display: none; }
    .navlink { display: none; }
  }
</style>

<script>
  const bind = () => {
    const btn = document.querySelector('[data-theme-toggle]');
    btn?.addEventListener('click', () => {
      const cur = document.documentElement.getAttribute('data-theme');
      const isDark = cur ? cur === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('salt-theme', next); } catch (e) {}
    });
  };
  document.addEventListener('astro:page-load', bind);
</script>
